@model IEnumerable<Ecommproject_Model127.Product>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@(string.IsNullOrEmpty(product.imageurl) ? "~/images/no-image.png" : product.imageurl)"
                     class="card-img-top rounded"
                     alt="@product.Title" />

                <div class="card-body">
                    <h5 class="card-title text-dark">
                        <b>@product.Title</b>
                    </h5>

                    <p class="mb-1">
                        List Price:
                        <strike><b>$@($"{product.ListPrice:0.00}")</b></strike>
                    </p>
                    <p class="text-danger mb-2">
                        Price 50:
                        <b>$@($"{product.Price50:0.00}")</b>
                    </p>
                </div>

                <div class="card-footer bg-transparent border-0">
                    <a asp-action="Details" asp-route-id="@product.Id"
                       class="btn btn-primary w-100">Details</a>
                </div>
            </div>
        </div>
    }
</div>
