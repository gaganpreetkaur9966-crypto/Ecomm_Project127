<div class="row">
    <div class="col-9">
        <h2 class="text-info">Product List</h2>
    </div>
    <div class="col-3">
        <a asp-action="upsert" class="btn btn-info form-control">
            <i class="fas fa-plus"></i>&nbsp; Add NewProduct
        </a>
    </div>
</div>
<div class="container rounded border p-2 m-2">
    <table id="tblData" class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>                
                <th>ISBN</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
    </table>
</div>
@section scripts
{
    <script src="~/js/Product.js"></script>
}